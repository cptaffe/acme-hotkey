<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>zip.connor.acme-hotkeys</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>printf 'acme\n' | 9p write acme-hotkey/filter &amp;&amp; 9p read acme-hotkey/keys | cawk -f /Users/cptaffe/src/acme-hotkey/hotkeys.cawk</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/cptaffe</string>
		<key>PLAN9</key>
		<string>/Users/cptaffe/src/plan9port</string>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/go/bin:/Users/cptaffe/bin:/Users/cptaffe/go/bin:/Users/cptaffe/src/plan9port/bin</string>
		<key>GOPATH</key>
		<string>/Users/cptaffe/go</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>PathState</key>
		<dict>
			<key>/tmp/ns.cptaffe.:0/acme</key>
			<true/>
			<key>/tmp/ns.cptaffe.:0/acme-hotkey</key>
			<true/>
		</dict>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/cptaffe/Library/Logs/connor.zip/acme-hotkeys/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/cptaffe/Library/Logs/connor.zip/acme-hotkeys/launchd-stderr.log</string>
</dict>
</plist>
