# hotkeys.cawk — dispatch acme hotkeys from the acme-hotkey keys stream.
#
# Run via launchd (zip.connor.acme-hotkeys) or manually:
#
#   9p read acme-hotkey/keys | cawk -f hotkeys.cawk | 9p write acme-hotkey/keys
#
# The keys file works like Acme's event file: reading delivers one event per
# line; writing back acknowledges it.  Write-backs decide the event's fate:
#
#   print $0          → forward: original event re-posted to the application
#   printf "!%s", $0  → drop:    original event consumed (hotkey handled here)
#
# Execution model:
#   cawk reads input line-by-line (standard AWK semantics).  $0 is each line
#   WITHOUT the trailing newline.  Top-level /^re$/ patterns match $0 as usual.
#
# To drop a matched event: print "!" $0
#   (print appends ORS="\n"; the server splits write-backs on "\n")
#
# To forward an event unchanged: print $0
#   (same — print appends the required newline)
#
# Event format (space-separated, modifiers first):
#   command b          ⌘B (initial press)
#   repeat command b   ⌘B (auto-repeat)
#   shift a            ⇧A
#   escape             Escape
#
# ── Keytab ───────────────────────────────────────────────────────────────────
#   ⌘S            command s             Put
#   ⌘⇧S           command shift s       Putall
#   ⌘⇧F           command shift f       Look
#   ⌘W            command w             Del
#   ⌘⇧W           command shift w       Delcol
#   ⌘N            command n             New
#   ⌘⇧N           command shift n       Newcol
#   ⌘;            command semicolon     Spell
#   ⌘T            command t             win
#   ⌘B            command b             Ldef
#   ⌘⇧B           command shift b       Lrefs
#   Escape         escape               V
#   ⌘P            command p             Search
#   ⌘⇧H           command shift h       Highlight
# ─────────────────────────────────────────────────────────────────────────────

BEGIN {
    ns = ENVIRON["NAMESPACE"]
    if (ns == "") {
        "namespace" | getline ns
        close("namespace")
    }
}

# focused_win returns the window ID from acme-focused, validated against the
# live acme index.  Returns 0 if unavailable or if the window no longer exists.
function focused_win(    pipe, id) {
    pipe = "9p read acme-focused/focus"
    pipe | getline id
    close(pipe)
    return id + 0
}

function ctl(winid, cmd) {
    print cmd | ("9p write acme/" winid "/ctl")
    close("9p write acme/" winid "/ctl")
}

function err(winid, msg) {
    print msg | ("9p write acme/" winid "/errors")
    close("9p write acme/" winid "/errors")
}

function putall(    pipe, line, a, id, isdir, ismod) {
    pipe = "9p read acme/index"
    while ((pipe | getline line) > 0) {
        if (split(line, a) < 6) { continue }
        id    = a[1] + 0
        isdir = a[4] + 0
        ismod = a[5] + 0
        if (!isdir && ismod) { ctl(id, "put") }
    }
    close(pipe)
}

function run(cmd,    winid, errpipe, runcmd, line) {
    # New does not require a focused window — always allowed.
    if (cmd == "New")    { system("9p read acme/new/ctl > /dev/null"); return }
    if (cmd == "Putall") { putall(); return }

    winid = focused_win()
    if (winid == 0) { return }

    if (cmd == "Put")    { ctl(winid, "put");    return }
    if (cmd == "Get")    { ctl(winid, "get");    return }
    if (cmd == "Del")    { ctl(winid, "del");    return }
    if (cmd == "Delete") { ctl(winid, "delete"); return }

    errpipe = "9p write acme/" winid "/errors"
    runcmd  = "winid=" winid " " cmd " 2>&1"
    while ((runcmd | getline line) > 0) {
        print line | errpipe
    }
    close(runcmd)
    close(errpipe)
}

# ── Acme built-in keytab ─────────────────────────────────────────────────────
# Each pattern is an x-expression that matches the exact event line including
# its trailing newline.  $0 = "command s\n"; printf "!%s" re-emits it with the
# leading "!" that signals the hotkey was consumed (no extra newline from ORS).

/^command s$/          { run("Put");       print "!" $0; fflush() }
/^command shift s$/    { run("Putall");    print "!" $0; fflush() }
/^command shift f$/    { run("Look");      print "!" $0; fflush() }
/^command w$/          { run("Del");       print "!" $0; fflush() }
/^command shift w$/    { run("Delcol");    print "!" $0; fflush() }
/^command n$/          { run("New");       print "!" $0; fflush() }
/^command shift n$/    { run("Newcol");    print "!" $0; fflush() }
/^command semicolon$/  { run("Spell");     print "!" $0; fflush() }
/^command t$/          { run("win");       print "!" $0; fflush() }
/^command b$/          { run("Ldef");      print "!" $0; fflush() }
/^command shift b$/    { run("Lrefs");     print "!" $0; fflush() }
/^escape$/             { run("V");         print "!" $0; fflush() }
/^command p$/          { run("Search");    print "!" $0; fflush() }
/^command shift h$/    { run("Highlight"); print "!" $0; fflush() }

# ── Default: forward all unmatched events back to the application ─────────────
{ print $0; fflush() }
